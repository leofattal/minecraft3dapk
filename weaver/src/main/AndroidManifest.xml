<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Fullscreen 3D overlay windows over the launcher. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Weaver foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required by the Leia CNSDK (its system services do the face tracking). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- CNSDK queries the on-device Leia services; Shizuku manager. -->
    <queries>
        <package android:name="com.leia.headtrackingservice" />
        <package android:name="com.leialoft.display.config" />
        <package android:name="moe.shizuku.privileged.api" />
        <!-- Minecraft Bedrock (both historical package ids). -->
        <package android:name="com.mojang.minecraftpe" />
        <package android:name="com.mojang.minecraft" />
        <!-- This app IS a launcher: the picker must see every launchable app. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Weaver"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <!-- Leia system library (optional, present on Leia devices) -->
        <uses-library android:name="com.leia.android.lights" android:required="false" />

        <!-- Let the QNN HTP stub reach the Hexagon DSP RPC vendor library. -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".WeaverService"
            android:exported="false" />

        <!-- Shizuku binder provider (required by the Shizuku API). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
